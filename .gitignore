# ---------------------------------------------------------------------------
# CafeElRegioWeb - .gitignore (raíz del repositorio)
# ---------------------------------------------------------------------------
# Carpeta de recursos: SOLO LECTURA. Contiene imágenes, videos, PDF, ZIP,
# audio, 3D y archivos sensibles (cédulas, cupones bancarios, QR con llave
# Nequi). Nunca se sube al repositorio ni se publica en la web.
Recursos/

# PocketBase (binario descargado localmente, no se commitea)
pocketbase/

# Frontend (Vite + React)
web/node_modules/
web/dist/
web/dist-ssr/
web/*.local

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Script de setup de PocketBase (contiene credenciales de desarrollo)
web/setup-pocketbase.js

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editores y sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.tmp
*.swp

# TypeScript
*.tsbuildinfo
web/tsconfig.tsbuildinfo
